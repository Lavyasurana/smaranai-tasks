# Dependencies
node_modules
node_modules/
**/node_modules
**/node_modules/
.pnp
.pnp.js

# Production Build Outputs
dist/
**/dist/
dist-ssr/
build/
.output/
*.zip

# Environment Variables & Secrets (Prevent accidental leaks to GitHub)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.local

